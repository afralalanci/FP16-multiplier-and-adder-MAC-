// ============================================================
// FP16 MAC Testbench
// ============================================================

module tb_mac53();

    logic clk53;
    logic rst53;


    // --------------------------------------------------------
    // Test Vectors
    // --------------------------------------------------------

    logic [15:0] a_arr53 [0:12];
    logic [15:0] b_arr53 [0:12];

    logic [15:0] g_prod_arr53 [0:12];
    logic [15:0] g_acc_arr53  [0:12];


    // --------------------------------------------------------
    // DUT Signals
    // --------------------------------------------------------

    logic [15:0] a_in53;
    logic [15:0] b_in53;

    logic [15:0] mult_out53;
    logic [15:0] acc_out53;
    logic [15:0] add_out53;

    integer i53;


    // ========================================================
    // FP16 Multiplier
    // ========================================================

    fp16_mult53 u_mult53 (
        .clk53  (clk53),
        .rst53  (rst53),
        .a53    (a_in53),
        .b53    (b_in53),
        .prod53 (mult_out53)
    );


    // ========================================================
    // FP16 Adder
    // ========================================================

    fp16_add53 u_add53 (
        .clk53 (clk53),
        .rst53 (rst53),
        .a53   (mult_out53),
        .b53   (acc_out53),
        .sum53 (add_out53)
    );


    // ========================================================
    // Clock Generation
    // ========================================================

    initial begin

        $dumpfile("dump.vcd");
        $dumpvars(0, tb_mac53);

        clk53 = 1'b0;

        forever #5 clk53 = ~clk53;

    end


    // ========================================================
    // Test Stimulus
    // ========================================================

    initial begin

        // ----------------------------------------------------
        // Load Input Vectors and Golden Results
        // ----------------------------------------------------

        a_arr53[0]  = 16'h2E66;
        b_arr53[0]  = 16'h3400;
        g_prod_arr53[0] = 16'h2666;
        g_acc_arr53[0]  = 16'h2666;

        a_arr53[1]  = 16'h3266;
        b_arr53[1]  = 16'hBB33;
        g_prod_arr53[1] = 16'hB1C2;
        g_acc_arr53[1] = 16'hB0F5;

        a_arr53[2]  = 16'h3400;
        b_arr53[2]  = 16'h3000;
        g_prod_arr53[2] = 16'h2800;
        g_acc_arr53[2] = 16'hAFEA;

        a_arr53[3]  = 16'hB4CD;
        b_arr53[3]  = 16'h3A66;
        g_prod_arr53[3] = 16'hB3AE;
        g_acc_arr53[3] = 16'hB5D2;

        a_arr53[4]  = 16'h3666;
        b_arr53[4]  = 16'h3B00;
        g_prod_arr53[4] = 16'h3599;
        g_acc_arr53[4] = 16'hA320;

        a_arr53[5]  = 16'h3800;
        b_arr53[5]  = 16'hBA00;
        g_prod_arr53[5] = 16'hB600;
        g_acc_arr53[5] = 16'hB639;

        a_arr53[6]  = 16'h3866;
        b_arr53[6]  = 16'h34CD;
        g_prod_arr53[6] = 16'h3147;
        g_acc_arr53[6] = 16'hB32B;

        a_arr53[7]  = 16'h38CD;
        b_arr53[7]  = 16'h38CD;
        g_prod_arr53[7] = 16'h35C3;
        g_acc_arr53[7] = 16'h305B;

        a_arr53[8]  = 16'hBA00;
        b_arr53[8]  = 16'h2E66;
        g_prod_arr53[8] = 16'hACCC;
        g_acc_arr53[8] = 16'h2BD4;

        a_arr53[9]  = 16'h3A66;
        b_arr53[9]  = 16'h3266;
        g_prod_arr53[9] = 16'h311E;
        g_acc_arr53[9] = 16'h3313;

        a_arr53[10] = 16'h3B00;
        b_arr53[10] = 16'hB666;
        g_prod_arr53[10] = 16'hB599;
        g_acc_arr53[10] = 16'hB01F;

        a_arr53[11] = 16'h3B33;
        b_arr53[11] = 16'h3866;
        g_prod_arr53[11] = 16'h37EB;
        g_acc_arr53[11] = 16'h35DC;

        a_arr53[12] = 16'h399A;
        b_arr53[12] = 16'hB800;
        g_prod_arr53[12] = 16'hB59A;
        g_acc_arr53[12] = 16'h2420;


        // ----------------------------------------------------
        // Reset
        // ----------------------------------------------------

        rst53    = 1'b1;
        a_in53   = 16'b0;
        b_in53   = 16'b0;
        acc_out53 = 16'b0;

        #20;

        rst53 = 1'b0;


        // ----------------------------------------------------
        // Display Header
        // ----------------------------------------------------

        $display(
            "Idx A(Hex) B(Hex) Prod_HW Prod_Gold Acc_HW Acc_Gold"
        );


        // ----------------------------------------------------
        // Run Test Vectors
        // ----------------------------------------------------

        for (
            i53 = 0;
            i53 < 13;
            i53 = i53 + 1
        ) begin

            a_in53 = a_arr53[i53];
            b_in53 = b_arr53[i53];


            // Wait for pipeline to flush
            repeat (6)
                @(posedge clk53);


            #1;


            // Capture accumulator output
            acc_out53 = add_out53;


            $display(
                "%2d %04X %04X %04X %04X %04X %04X",
                i53,
                a_in53,
                b_in53,
                mult_out53,
                g_prod_arr53[i53],
                acc_out53,
                g_acc_arr53[i53]
            );

        end


        $finish;

    end

endmodule
