import numpy as np


# ============================================================
# Input Vectors
# ============================================================

a_vec_53 = [
    0.1,
    0.2,
    0.25,
    -0.3,
    0.4,
    0.5,
    0.55,
    0.6,
    -0.75,
    0.8,
    0.875,
    0.9,
    0.7
]

b_vec_53 = [
    0.25,
    -0.9,
    0.125,
    0.8,
    0.875,
    -0.75,
    0.3,
    0.6,
    0.1,
    0.2,
    -0.4,
    0.55,
    -0.5
]


# ============================================================
# Convert FP16 Value to Hex
# ============================================================

def get_hex_53(value):
    fp16_value = np.float16(value)

    return f"0x{fp16_value.view(np.uint16):04X}"


# ============================================================
# FP16 Golden Model
# ============================================================

acc_53 = np.float16(0.0)


print(
    f"{'Index':<6}"
    f"{'A (Dec)':<8}"
    f"{'A (Hex)':<8}"
    f"{'B (Dec)':<8}"
    f"{'B (Hex)':<8}"
    f"{'Prod (Hex)':<10}"
    f"{'Acc (Hex)':<10}"
)


for i in range(len(a_vec_53)):

    # FP16 multiplication
    prod_53 = (
        np.float16(a_vec_53[i]) *
        np.float16(b_vec_53[i])
    )


    # FP16 accumulation
    acc_53 += prod_53


    print(
        f"{i:<6}"
        f"{a_vec_53[i]:<8}"
        f"{get_hex_53(a_vec_53[i]):<8}"
        f"{b_vec_53[i]:<8}"
        f"{get_hex_53(b_vec_53[i]):<8}"
        f"{get_hex_53(prod_53):<10}"
        f"{get_hex_53(acc_53):<10}"
    )
